# секреты и окружение
.env
*.env
server/.env
certs/

# python
server/.venv/
__pycache__/
*.pyc

# БД аккаунтов (хэши паролей, личные данные) — не коммитить
server/data/

# временное / скачанные ТЗ с ПДн
scratchpad/
*.log

# секреты фронта (токен Telegram-бота) — не коммитить
site/js/secrets.js

# снапшот закупок — на ~4000+ закупках это уже не 2 МБ, а ближе к 7; коммитить
# ежечасно раздувало бы git-историю на гигабайты за месяцы. Доставляется на VPS
# напрямую по scp (tools/refresh.sh), не через git. См. CLAUDE.md / plan.md §3.
site/data/purchases.json
site/data/tz.json
site/data/docs.json
site/data/spec.json
site/data/tztext.json
site/data/analytics.json

# playwright и браузеры
tools/node_modules/

# рабочий кэш сборщика (карточки ЕИС: документы/регион/срок) — накапливается
# между прогонами, машинно-специфичен, не деплоится. См. tools/build_snapshot.js
tools/.cache/
